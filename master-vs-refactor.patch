-				idx = "tashas-hideous-laughter"
-			}
-		} else {
-			switch strings.ToLower(n) {
-			case "scale mail":
-				idx = "scale-mail"
-			case "leather armor":
-				idx = "leather-armor"
-			case "chain shirt":
-				idx = "chain-shirt"
-			case "half plate":
-				idx = "half-plate"
-			case "ring mail":
-				idx = "ring-mail"
-			case "chain mail":
-				idx = "chain-mail"
-			case "splint armor":
-				idx = "splint"
-			case "plate armor":
-				idx = "plate"
-			}
-		}
