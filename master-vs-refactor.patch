-func UniqueIndices(names []string, spell bool) map[string]string {
-	m := map[string]string{}
-	for _, n := range names {
-		n = strings.TrimSpace(n)
-		if n == "" {
-			continue
-		}
-		idx := sanitizeIndex(n)
-		if spell {
-			switch strings.ToLower(n) {
-			case "tasha's hideous laughter":
-				idx = "tashas-hideous-laughter"
-			}
-		} else {
-			switch strings.ToLower(n) {
-			case "scale mail":
-				idx = "scale-mail"
-			case "leather armor":
-				idx = "leather-armor"
-			case "chain shirt":
-				idx = "chain-shirt"
-			case "half plate":
-				idx = "half-plate"
-			case "ring mail":
-				idx = "ring-mail"
-			case "chain mail":
-				idx = "chain-mail"
-			case "splint armor":
-				idx = "splint"
-			case "plate armor":
-				idx = "plate"
-			}
-		}
-		m[n] = idx
-	}
-	return m
-}
