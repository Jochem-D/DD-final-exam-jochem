+		case "-weapon":
+			if i+1 < len(args) {
+				input.Weapon = args[i+1]
+				i++
+			}
+		case "-armor":
+			if i+1 < len(args) {
+				input.Armor = args[i+1]
+				i++
+			}
+		case "-shield":
+			if i+1 < len(args) {
+				input.Shield = args[i+1]
+				i++
+			}
+		case "-slot":
+			if i+1 < len(args) {
+				input.Slot = args[i+1]
+				i++
+			}
+		}
+	}
+
+	return input
+}
