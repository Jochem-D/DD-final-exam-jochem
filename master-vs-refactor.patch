+		}
+		fmt.Printf("Equipped weapon %s to %s\n", input.Weapon, slot)
+	}
+	if input.Armor != "" {
+		fmt.Printf("Equipped armor %s\n", input.Armor)
+	}
+	if input.Shield != "" {
+		fmt.Printf("Equipped shield %s\n", input.Shield)
