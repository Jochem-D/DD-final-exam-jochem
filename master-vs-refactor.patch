+	c.DeriveStatsUseCase = usecases.NewDeriveCharacterStatsUseCase(c.CharacterRepo, c.CharacterService)
+	c.EnrichDataUseCase = usecases.NewEnrichDataUseCase(c.EnrichmentRepo)
