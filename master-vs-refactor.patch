-// parseInt tries to parse various types to int, returns (value, true) if successful
-func parseInt(v any) (int, bool) {
-	switch t := v.(type) {
-	case float64:
-		return int(t), true
-	case int:
-		return t, true
-	case int64:
-		return int(t), true
-	case json.Number:
